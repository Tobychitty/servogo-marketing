---
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageType?: 'home' | 'trade' | 'comparison' | 'blog' | 'pricing';
  schema?: object | object[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/assets/screen-day-view.png',
  pageType = 'home',
  schema,
  breadcrumbs,
} = Astro.props;

const siteUrl = 'https://servogo.co.uk';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;

// Meta (Facebook) Pixel id. Public by design (ships in the browser). Keep in sync
// with the app's VITE_META_PIXEL_ID so cold ad clicks and signups share one pixel.
const metaPixelId = '1249855560421180';

const schemas: object[] = [];

if (pageType === 'home' || pageType === 'trade') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Servogo',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: {
      '@type': 'Offer',
      priceCurrency: 'GBP',
      price: '25',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '25',
        priceCurrency: 'GBP',
        unitText: 'MONTH',
      },
    },
    description: description,
    url: siteUrl,
  });
}

if (breadcrumbs && breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      ...breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: crumb.name,
        item: `${siteUrl}${crumb.url}`,
      })),
    ],
  });
}

if (schema) {
  if (Array.isArray(schema)) schemas.push(...schema);
  else schemas.push(schema);
}
---
<!doctype html>
<html lang="en">
<head>
<SiteHead
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  siteUrl={siteUrl}
  schemas={schemas}
/>
<slot name="head" />
<!-- Meta Pixel -->
<script is:inline define:vars={{ metaPixelId }}>
  !(function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
    t = b.createElement(e); t.async = !0;
    t.src = v; s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', metaPixelId);
  fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none" alt=""
  src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} /></noscript>
<!-- End Meta Pixel -->
</head>
<body>

<SiteNav />

<!-- ─── Page content ─────────────────────────────────────── -->
<slot />

<SiteFooter />

<script>
  // Reveal on scroll
  (function () {
    var els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();

  // FAQ single open at a time
  (function () {
    var faqs = document.querySelectorAll('details.faq');
    faqs.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) {
          faqs.forEach(function (other) {
            if (other !== d) other.open = false;
          });
        }
      });
    });
  })();
</script>

</body>
</html>
