---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageType?: 'home' | 'trade' | 'comparison' | 'blog' | 'pricing';
  schema?: object | object[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/assets/screen-day-view.png',
  pageType = 'home',
  schema,
  breadcrumbs,
} = Astro.props;

const siteUrl = 'https://servogo.co.uk';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;

const schemas: object[] = [];

if (pageType === 'home' || pageType === 'trade') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Servogo',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: {
      '@type': 'Offer',
      priceCurrency: 'GBP',
      price: '25',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '25',
        priceCurrency: 'GBP',
        unitText: 'MONTH',
      },
    },
    description: description,
    url: siteUrl,
  });
}

if (breadcrumbs && breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      ...breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: crumb.name,
        item: `${siteUrl}${crumb.url}`,
      })),
    ],
  });
}

if (schema) {
  if (Array.isArray(schema)) schemas.push(...schema);
  else schemas.push(schema);
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/assets/servogo.svg" />

<!-- Open Graph / social -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${siteUrl}${ogImage}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

<!-- Schema.org JSON-LD -->
{schemas.map(s => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<slot name="head" />

<style is:global>
  :root {
    --font-body: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;

    --accent: #ff4d50;
    --accent-hover: #e63a3d;
    --accent-rgb: 255, 77, 80;
    --brand-700: #c42d30;
    --brand-50:  #fff1f1;

    --bg: #ffffff;
    --bg-subtle: #f9f9f9;
    --bg-muted: #f3f3f3;
    --bg-soft: #f1f2f4;

    --ink: #0f172a;
    --text-secondary: #334155;
    --text-muted: #5f6b7c;
    --text-tertiary: #94a3b8;

    --stroke-soft: #ececef;
    --stroke-regular: #e4e7ec;
    --border-strong: #d0d3da;

    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.04);
    --shadow-button: 0 1px 2px rgba(15, 23, 42, 0.06);
    --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.04), 0 8px 24px rgba(15, 23, 42, 0.04);
    --shadow-screen: 0 1px 1px rgba(15, 23, 42, 0.05),
                     0 4px 12px rgba(15, 23, 42, 0.06),
                     0 24px 60px -12px rgba(15, 23, 42, 0.18);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 20px;

    --container: 1180px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--bg);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-feature-settings: 'cv11', 'ss01';
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; }

  ::selection { background: rgba(var(--accent-rgb), 0.18); color: var(--ink); }

  .container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ── Buttons ─────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
    white-space: nowrap;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease, box-shadow 140ms ease, transform 80ms ease;
  }
  .btn:active:not(:disabled) { transform: translateY(1px); }
  .btn-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 1px 0 rgba(127, 29, 29, 0.22) inset, 0 1px 2px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(127, 29, 29, 0.18);
  }
  .btn-primary:hover { background: var(--accent-hover); }
  .btn-secondary {
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--stroke-regular);
    box-shadow: var(--shadow-button);
  }
  .btn-secondary:hover { background: var(--bg-subtle); border-color: var(--border-strong); }
  .btn-ghost { color: var(--text-secondary); }
  .btn-ghost:hover { color: var(--ink); }
  .btn-sm { height: 36px; padding: 0 14px; font-size: 14px; }
  .btn-lg { height: 50px; padding: 0 22px; font-size: 16px; }
  .btn .arrow { transition: transform 160ms ease; }
  .btn:hover .arrow { transform: translateX(2px); }

  /* ── Top nav ─────────────────────────────────────────────── */
  .nav-wrap {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease, background 200ms ease;
  }
  .nav-wrap.is-scrolled { border-bottom-color: var(--stroke-soft); }
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    height: 64px;
  }
  .nav-logo { display: inline-flex; align-items: center; height: 28px; }
  .nav-logo img { height: 28px; width: auto; }
  .nav-links {
    display: flex; gap: 4px; align-items: center;
  }
  .nav-link {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: background-color 140ms ease, color 140ms ease;
  }
  .nav-link:hover { color: var(--ink); background: var(--bg-subtle); }
  .nav-actions { display: flex; align-items: center; gap: 8px; }
  @media (max-width: 820px) {
    .nav-links { display: none; }
  }

  /* ── Section base ────────────────────────────────────────── */
  section { position: relative; }
  .section { padding: 96px 0; }
  .section-tight { padding: 72px 0; }
  .section-eyebrow {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .section-title {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 16px;
    color: var(--ink);
    text-wrap: balance;
  }
  .section-sub {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 620px;
    text-wrap: pretty;
  }
  .section-head { max-width: 720px; margin-bottom: 56px; }
  .section-head.center { text-align: center; margin-left: auto; margin-right: auto; }
  .section-head.center .section-sub { margin-left: auto; margin-right: auto; }

  /* ── Three-up feature grid ───────────────────────────────── */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .feature-card {
    padding: 28px;
    background: #fff;
    border: 1px solid var(--stroke-regular);
    border-radius: var(--radius-xl);
    transition: border-color 180ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .feature-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
  }
  .feature-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    display: grid; place-items: center;
    background: var(--brand-50);
    color: var(--accent);
    margin-bottom: 18px;
  }
  .feature-icon svg { width: 20px; height: 20px; }
  .feature-card h3 {
    font-size: 17px; font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .feature-card p {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-muted);
    line-height: 1.55;
  }
  @media (max-width: 820px) {
    .feature-grid { grid-template-columns: 1fr; }
  }

  /* ── Deep dives (alternating) ────────────────────────────── */
  .deep {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 72px;
    align-items: center;
  }
  .deep.reverse { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .deep.reverse .deep-copy { order: 2; }
  .deep.reverse .deep-shot { order: 1; }

  .deep-copy .section-eyebrow { margin-bottom: 14px; }
  .deep-copy h2 {
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .deep-copy .lede {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 24px;
  }
  .deep-list { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 14px; }
  .deep-list li {
    display: flex; gap: 12px;
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .deep-list .check {
    flex: 0 0 22px;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--accent);
    display: grid; place-items: center;
    margin-top: 1px;
  }
  .deep-list .check svg { width: 12px; height: 12px; stroke-width: 2.5; }
  .deep-list strong { color: var(--ink); font-weight: 600; }
  .text-link {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--accent);
    font-weight: 500;
    font-size: 15px;
    transition: color 140ms ease, gap 140ms ease;
  }
  .text-link:hover { color: var(--accent-hover); gap: 8px; }

  /* Deep-dive screenshot frame */
  .deep-shot {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--stroke-regular);
    box-shadow: var(--shadow-screen);
  }
  .deep-shot .browser-bar { padding: 9px 12px; }
  .deep-shot img { width: 100%; height: auto; display: block; }
  .deep-shot::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.02);
  }

  @media (max-width: 900px) {
    .deep, .deep.reverse { grid-template-columns: 1fr; gap: 36px; }
    .deep.reverse .deep-copy { order: 1; }
    .deep.reverse .deep-shot { order: 2; }
  }

  /* ── Divider rule ───────────────────────────────────────── */
  .rule {
    height: 1px;
    background: linear-gradient(to right, transparent 0%, var(--stroke-regular) 20%, var(--stroke-regular) 80%, transparent 100%);
    margin: 0;
  }

  /* ── Pricing ─────────────────────────────────────────────── */
  .pricing {
    background: var(--bg-subtle);
    border-top: 1px solid var(--stroke-soft);
    border-bottom: 1px solid var(--stroke-soft);
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .price-card {
    padding: 32px;
    background: #fff;
    border: 1px solid var(--stroke-regular);
    border-radius: var(--radius-xl);
    display: flex; flex-direction: column;
    position: relative;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }
  .price-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-card); }
  .price-card.featured {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06), 0 24px 48px -12px rgba(15, 23, 42, 0.28);
  }
  .price-tier {
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .price-card.featured .price-tier { color: rgba(255,255,255,0.7); }
  .pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    background: var(--accent);
    color: #fff;
    text-transform: uppercase;
  }
  .price-amount {
    display: flex; align-items: baseline; gap: 4px;
    margin: 8px 0 6px;
  }
  .price-amount .num {
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .price-amount .cur {
    font-size: 22px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .price-card.featured .price-amount .cur { color: rgba(255,255,255,0.7); }
  .price-amount .per { font-size: 14px; color: var(--text-muted); margin-left: 2px; }
  .price-card.featured .price-amount .per { color: rgba(255,255,255,0.7); }
  .price-desc {
    font-size: 14.5px;
    color: var(--text-muted);
    margin: 0 0 22px;
    line-height: 1.5;
  }
  .price-card.featured .price-desc { color: rgba(255,255,255,0.75); }
  .price-cta { width: 100%; margin-bottom: 24px; }
  .price-card.featured .btn-primary {
    background: #fff; color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,0.18);
  }
  .price-card.featured .btn-primary:hover { background: #f1f2f4; }
  .price-features { list-style: none; padding: 0; margin: 0; display: grid; gap: 11px; }
  .price-features li {
    display: flex; gap: 10px;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .price-card.featured .price-features li { color: rgba(255,255,255,0.85); }
  .price-features svg {
    flex-shrink: 0;
    width: 16px; height: 16px;
    margin-top: 2px;
    color: var(--accent);
  }
  .pricing-foot {
    margin-top: 32px;
    text-align: center;
    font-size: 14.5px;
    color: var(--text-muted);
  }
  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; }
  }

  /* ── FAQ ─────────────────────────────────────────────────── */
  .faq-grid {
    max-width: 780px;
    margin: 0 auto;
  }
  details.faq {
    border-bottom: 1px solid var(--stroke-regular);
    padding: 0;
  }
  details.faq:first-of-type { border-top: 1px solid var(--stroke-regular); }
  details.faq > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    transition: color 140ms ease;
  }
  details.faq > summary::-webkit-details-marker { display: none; }
  details.faq > summary:hover { color: var(--accent); }
  details.faq .chev {
    flex-shrink: 0;
    width: 26px; height: 26px;
    border-radius: 50%;
    display: grid; place-items: center;
    color: var(--text-muted);
    transition: transform 220ms ease, color 140ms ease, background 140ms ease;
  }
  details.faq .chev svg { width: 14px; height: 14px; }
  details.faq[open] .chev { transform: rotate(180deg); color: var(--accent); }
  details.faq .answer {
    padding: 0 4px 24px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 680px;
  }

  /* ── Footer CTA ─────────────────────────────────────────── */
  .footer-cta {
    padding: 120px 0 96px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .footer-cta::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(50% 60% at 50% 100%, rgba(255, 77, 80, 0.07) 0%, rgba(255, 77, 80, 0) 70%);
    pointer-events: none;
  }
  .footer-cta-inner { position: relative; }
  .footer-cta h2 {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .footer-cta p {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 0 32px;
  }

  /* ── Site footer ─────────────────────────────────────────── */
  footer.site-foot {
    padding: 48px 0 56px;
    border-top: 1px solid var(--stroke-soft);
    background: #fff;
  }
  .foot-row {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 48px;
    align-items: start;
  }
  .foot-brand img { height: 24px; width: auto; }
  .foot-brand p {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--text-muted);
    max-width: 280px;
    line-height: 1.55;
  }
  .foot-col h4 {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 14px;
  }
  .foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .foot-col a {
    font-size: 14px;
    color: var(--text-secondary);
    transition: color 140ms ease;
  }
  .foot-col a:hover { color: var(--accent); }
  .foot-bottom {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--stroke-soft);
    font-size: 13px;
    color: var(--text-tertiary);
  }
  @media (max-width: 820px) {
    .foot-row { grid-template-columns: 1fr 1fr; gap: 32px; }
    .foot-brand { grid-column: span 2; }
    .foot-bottom { flex-direction: column; gap: 12px; align-items: flex-start; }
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: 80px 0 0;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(255, 77, 80, 0.05) 0%, rgba(255, 77, 80, 0) 70%),
      linear-gradient(to right, rgba(15,23,42,0.04) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(to bottom, rgba(15,23,42,0.04) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: radial-gradient(60% 60% at 50% 30%, #000 35%, transparent 100%);
    -webkit-mask-image: radial-gradient(60% 60% at 50% 30%, #000 35%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner { position: relative; z-index: 1; text-align: center; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 12px 5px 8px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--stroke-regular);
    box-shadow: var(--shadow-button);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }
  .eyebrow .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.16);
  }
  .eyebrow strong { color: var(--ink); font-weight: 600; }
  .hero h1 {
    font-size: clamp(40px, 6.2vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 0 0 22px;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero h1 .accent { color: var(--accent); }
  .hero-sub {
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 32px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hero-ctas {
    display: inline-flex; align-items: center; gap: 12px;
    flex-wrap: wrap; justify-content: center;
  }
  .hero-meta {
    display: flex; align-items: center; gap: 18px;
    margin: 18px 0 0;
    font-size: 13px;
    color: var(--text-tertiary);
    flex-wrap: wrap; justify-content: center;
  }
  .hero-meta .sep { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: 0.5; }
  .hero-meta .check { color: var(--accent); }

  /* Hero screenshot frame */
  .hero-shot-wrap {
    position: relative;
    margin-top: 64px;
  }
  .hero-shot-wrap::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -1px; height: 220px;
    background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, #fff 80%);
    pointer-events: none;
    z-index: 2;
  }
  .browser {
    position: relative;
    margin: 0 auto;
    max-width: 1140px;
    border-radius: 14px 14px 0 0;
    background: #fff;
    border: 1px solid var(--stroke-regular);
    border-bottom: 0;
    box-shadow: var(--shadow-screen);
    overflow: hidden;
  }
  .browser-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 11px 14px;
    background: #fafafb;
    border-bottom: 1px solid var(--stroke-soft);
  }
  .browser-dots { display: flex; gap: 6px; }
  .browser-dots i {
    display: block; width: 11px; height: 11px; border-radius: 50%;
    background: #e1e3e8;
  }
  .browser-url {
    flex: 1; max-width: 420px;
    margin: 0 auto;
    height: 22px; padding: 0 10px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid var(--stroke-soft);
    font-size: 11.5px;
    color: var(--text-muted);
    display: inline-flex; align-items: center; gap: 6px;
    justify-content: center;
  }
  .browser-url svg { width: 11px; height: 11px; color: var(--text-tertiary); }
  .browser-shot { display: block; width: 100%; height: auto; }

  /* ── Reveal ─────────────────────────────────────────────── */
  .reveal { opacity: 0; transform: translateY(16px); transition: opacity 700ms ease, transform 700ms ease; }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; }
  }

  /* ── Page hero (trade/comparison pages) ─────────────────── */
  .page-hero {
    padding: 72px 0 64px;
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 50% at 50% 0%, rgba(255, 77, 80, 0.05) 0%, rgba(255, 77, 80, 0) 70%);
    pointer-events: none;
  }
  .page-hero-inner { position: relative; z-index: 1; max-width: 760px; }
  .page-hero h1 {
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 20px;
    color: var(--ink);
    text-wrap: balance;
  }
  .page-hero p {
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0 0 32px;
    max-width: 600px;
  }

  /* ── Comparison table ───────────────────────────────────── */
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .comparison-table th {
    padding: 14px 20px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--stroke-regular);
  }
  .comparison-table th:not(:first-child) { text-align: center; }
  .comparison-table td {
    padding: 14px 20px;
    border-bottom: 1px solid var(--stroke-soft);
    color: var(--text-secondary);
    vertical-align: middle;
  }
  .comparison-table td:not(:first-child) { text-align: center; }
  .comparison-table tr:last-child td { border-bottom: none; }
  .comparison-table .yes { color: var(--accent); font-weight: 600; }
  .comparison-table .no { color: var(--text-tertiary); }
  .comparison-table .partial { color: var(--text-muted); font-style: italic; }
  .comparison-table-wrap {
    border: 1px solid var(--stroke-regular);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ── Blog ────────────────────────────────────────────────── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }
  .blog-card {
    padding: 28px;
    background: #fff;
    border: 1px solid var(--stroke-regular);
    border-radius: var(--radius-xl);
    transition: border-color 180ms ease, box-shadow 220ms ease;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .blog-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
  }
  .blog-card-tag {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .blog-card h2 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0;
    color: var(--ink);
  }
  .blog-card p {
    font-size: 14.5px;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }
  .blog-card-meta {
    font-size: 13px;
    color: var(--text-tertiary);
  }

  /* Blog post prose */
  .prose {
    max-width: 720px;
  }
  .prose h2 {
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 2.2em 0 0.6em;
    color: var(--ink);
  }
  .prose h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 1.8em 0 0.5em;
    color: var(--ink);
  }
  .prose p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 1.2em;
  }
  .prose ul, .prose ol {
    padding-left: 1.4em;
    margin: 0 0 1.2em;
  }
  .prose li {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 0.4em;
  }
  .prose strong { color: var(--ink); font-weight: 600; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose a:hover { color: var(--accent-hover); }
  .prose hr { border: none; border-top: 1px solid var(--stroke-regular); margin: 2em 0; }
  .prose :first-child { margin-top: 0; }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-tertiary);
    margin-bottom: 28px;
  }
  .breadcrumb a { color: var(--text-muted); transition: color 140ms ease; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .sep { color: var(--stroke-regular); }
</style>
</head>
