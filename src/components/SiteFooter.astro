---
// Footer call-to-action band plus the site footer columns.
---
<style>
  .foot-cookie-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
  }
  .foot-cookie-btn:hover { color: var(--ink); }
</style>

<!-- ─── Footer CTA ───────────────────────────────────────── -->
<section class="footer-cta" id="cta">
  <div class="container footer-cta-inner">
    <h2>Start the trial.<br />See the difference by Friday.</h2>
    <p>14 days free. No card required. Cancel in one click.</p>
    <div class="hero-ctas">
      <a href="https://app.servogo.co.uk/signup" class="btn btn-primary btn-lg">
        Start free
        <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h8M8 3l4 4-4 4"/></svg>
      </a>
      <a href="/#features" class="btn btn-secondary btn-lg">See how it works</a>
    </div>
  </div>
</section>

<!-- ─── Site footer ───────────────────────────────────────── -->
<footer class="site-foot">
  <div class="container">
    <div class="foot-row">
      <div class="foot-brand">
        <img src="/assets/servogo-wordmark.svg" alt="Servogo" />
        <p>Field service software that gets out of your way. Fewer tabs, more jobs done.</p>
      </div>
      <div class="foot-col">
        <h4>Product</h4>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>For your trade</h4>
        <ul>
          <li><a href="/window-cleaning-software">Window cleaning</a></li>
          <li><a href="/gardening-business-software">Gardening</a></li>
          <li><a href="/cleaning-business-software">Cleaning</a></li>
          <li><a href="/pool-service-software">Pool service</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Compare</h4>
        <ul>
          <li><a href="/vs-squeegee">Servogo vs Squeegee</a></li>
          <li><a href="/squeegee-alternative">Squeegee alternative</a></li>
          <li><a href="/cleaner-planner-alternative">Cleaner Planner alternative</a></li>
          <li><a href="/vs-jobber">Servogo vs Jobber</a></li>
          <li><a href="/jobber-alternative-uk">Jobber alternative UK</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; 2026 Tobsoft Ltd, trading as Servogo &middot; Made for trades, in the UK.</span>
      <span>
        <a href="/privacy">Privacy</a> &nbsp;&middot;&nbsp;
        <a href="/terms">Terms</a> &nbsp;&middot;&nbsp;
        <a href="/terms#data-processing">DPA</a> &nbsp;&middot;&nbsp;
        <button type="button" class="foot-cookie-btn" onclick="window.servogoOpenCookieSettings && window.servogoOpenCookieSettings()">Cookie settings</button>
      </span>
    </div>
  </div>
</footer>
