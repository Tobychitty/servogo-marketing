---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<div class="faq-grid">
  {items.map(item => (
    <details class="faq">
      <summary>
        {item.q}
        <span class="chev">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 5l4 4 4-4"/>
          </svg>
        </span>
      </summary>
      <div class="answer" set:html={item.a} />
    </details>
  ))}
</div>
