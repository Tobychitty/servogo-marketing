---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Servogo"
  description="That page doesn't exist. Head back to Servogo: field service software for owner-run trades."
>

<section class="section">
  <div class="container">
    <div style="max-width: 560px; margin: 48px auto; text-align: center;">
      <span class="section-eyebrow">404</span>
      <h1 class="section-title" style="margin-top: 8px;">That page isn't on the round.</h1>
      <p class="section-sub" style="margin: 16px 0 32px;">
        The page you're after has moved or never existed. These should get you back on route:
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/pricing" class="btn btn-secondary">Pricing</a>
        <a href="/blog" class="btn btn-secondary">Blog</a>
        <a href="/docs" class="btn btn-secondary">Docs</a>
      </div>
    </div>
  </div>
</section>

</Base>
